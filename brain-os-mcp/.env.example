# BrainOS MCP Server — Environment Variables
# Set these in your Claude Code MCP config (~/.claude/settings.json env block), not here.
# This file documents what variables are available.

# Absolute path to your my-brain repo root (set via MCP config env)
BRAIN_ROOT=/Users/rmcdonald/Repos/my-brain

# Anthropic API key — required for all direct-generation tools
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration token — required for live pipeline and career context
# Create at: https://www.notion.so/my-integrations
# Share your root workspace page with the integration to grant access to all sub-pages
NOTION_TOKEN=secret_...
