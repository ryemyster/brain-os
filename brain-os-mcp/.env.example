# BrainOS MCP Server — Environment Variables
# Set these in your Claude Code MCP config (~/.claude/settings.json env block), not in this file.
# This file documents what variables are available and what they do.

# Absolute path to your brain-os repo root
BRAIN_ROOT=/Users/yourname/Repos/brain-os

# Anthropic API key — required for all LLM calls (proctor, prep, apply, diagnose, etc.)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration token — required for live pipeline and career context
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...

# Supabase — required for persistent memory (companies, stories, sessions, proctor sessions)
# Get from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Ollama — required for embedding memory before writing to Supabase
# Default assumes Ollama running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# HTTP transport (optional — only needed if running as an HTTP server instead of stdio)
# MCP_TRANSPORT=http
# MCP_PORT=5556

# Model overrides (optional — defaults to Sonnet for generation, Haiku for evaluation)
# MODEL_GENERATOR=claude-sonnet-4-6
# MODEL_EVALUATOR=claude-haiku-4-5-20251001
